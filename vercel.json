{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/health", "destination": "/api/index.js" },
    { "source": "/api/run", "destination": "/api/index.js" },
    { "source": "/api/models", "destination": "/api/index.js" },
    { "source": "/api/agents", "destination": "/api/index.js" },
    { "source": "/api/analytics/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
